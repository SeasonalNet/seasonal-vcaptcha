[Unit]
Description=Seasonal VCaptcha recognizer daemon
After=network.target
Documentation=file:/opt/seasonal-vcaptcha/README.md

[Service]
Type=simple
WorkingDirectory=/opt/seasonal-vcaptcha
User=seasonal-vcaptcha
Group=asterisk
SupplementaryGroups=seasonal-vcaptcha
RuntimeDirectory=seasonal-vcaptcha
RuntimeDirectoryMode=0770
StateDirectory=seasonal-vcaptcha
StateDirectoryMode=0750
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/seasonal-vcaptcha/venv/bin/seasonal-vcaptcha-daemon --config /etc/seasonal-vcaptcha/config.yaml
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/run/seasonal-vcaptcha /var/lib/seasonal-vcaptcha /tmp/seasonal-vcaptcha

[Install]
WantedBy=multi-user.target
